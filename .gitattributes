# Auto detect text files and perform LF normalization
* text=auto

# Generated by the update cycle and by the build, and committed by the hourly
# workflow. Both sides of a pull will have touched them, so a line-by-line
# merge produces conflict markers inside a JSON file that nothing can then read.
#
# `merge=binary` tells git not to attempt a textual merge: on a conflict it
# leaves your copy intact instead of writing markers into it. Take the remote
# side and rebuild - see docs/DEPLOYMENT.md, "Working alongside the hourly
# commits".
data/state.json   merge=binary
public/**         merge=binary linguist-generated=true

# Fonts and images are binary already; say so explicitly.
*.woff2 binary
*.png   binary
